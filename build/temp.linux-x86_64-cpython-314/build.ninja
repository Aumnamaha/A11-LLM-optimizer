ninja_required_version = 1.3
cxx = c++

cflags = -pthread -B /home/aumnamaha/miniconda3/compiler_compat -fno-strict-overflow -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/aumnamaha/miniconda3/include -fPIC -O2 -isystem /home/aumnamaha/miniconda3/include -fPIC -I/home/aumnamaha/Documents/finalenv/lib/python3.14/site-packages/torch/include -I/home/aumnamaha/Documents/finalenv/lib/python3.14/site-packages/torch/include/torch/csrc/api/include -I/home/aumnamaha/Documents/finalenv/include -I/home/aumnamaha/miniconda3/include/python3.14 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=a11_cuda_engine -std=c++20
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
